{
  "name": "openGauss 文档检查配置",
  "config": {
    "base": {
      "docPath": "^(docs|docs-lite)/(zh|en)",
      "markdownlintRemoteConfigUrl": "https://raw.gitcode.com/opengauss/docs/raw/common/.doctools/markdownlint.config.json",
      "linkValidityCheckRemoteWhitelistUrl": "https://raw.gitcode.com/opengauss/docs/raw/common/.doctools/url.whitelist.json",
      "resourceExistenceCheckRemoteWhitelistUrl": "https://raw.gitcode.com/opengauss/docs/raw/common/.doctools/url.whitelist.json",
      "resourceExistenceCheckInSameLevel": true,
      "codespellCheckRemoteWhitelistUrl": "https://raw.gitcode.com/opengauss/docs/raw/common/.doctools/codespell.whitelist.json",
      "tocCheckDisableMdInToc": true,
      "ci": [
        "frontmatter-check",
        "tag-closed-check",
